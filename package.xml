<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">

  <name>mrs_ultraloc</name>
  <version>0.1.0</version>
  <description>Fusion of UVDAR bearings with UWB ranges into 3D positions of other vehicles</description>

  <maintainer email="radomir.novy@fel.cvut.cz">Radomír Nový</maintainer>

  <license>BSD 3-Clause</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>rosidl_default_generators</buildtool_depend>

  <depend>builtin_interfaces</depend>
  <depend>std_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>rclcpp</depend>
  <depend>eigen</depend>

  <!-- The two sensors: uvdar_core provides BearingObservationArrayStamped,
       uwb_driver provides UwbRangeStamped. -->
  <depend>uvdar_core</depend>
  <depend>uwb_driver</depend>

  <exec_depend>rosidl_default_runtime</exec_depend>
  <member_of_group>rosidl_interface_packages</member_of_group>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <!-- The two simulator nodes under scripts/ are Python, so rclpy is needed at run
       time and not only by the tests. Kept in test_depend as well: a dependency is
       satisfied by whichever entry applies, and dropping it from test_depend would
       make the test's own requirement implicit. -->
  <exec_depend>rclpy</exec_depend>

  <!-- single_camera_marker.launch.py starts RViz. Kept as exec_depend rather than
       a hard depend: the marker node itself is useful headless, publishing markers
       for someone else's RViz or a rosbag, and nothing about it needs a GUI. -->
  <exec_depend>rviz2</exec_depend>
  <exec_depend>visualization_msgs</exec_depend>
  <exec_depend>python3-numpy</exec_depend>

  <!-- The integration tests drive the real node over real topics, so they need
       rclpy and pytest at run time as well as at test-build time. -->
  <test_depend>ament_cmake_pytest</test_depend>
  <test_depend>python3-pytest</test_depend>
  <test_depend>rclpy</test_depend>
  <test_depend>ament_index_python</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>

</package>
